# Codzienna kopia bazy Acai Cup o 3:15 (zadanie 44, DevOps).
# Instalacja na serwerze:
#   sudo cp scripts/acai-backup.cron /etc/cron.d/acai-backup
#   sudo chmod 644 /etc/cron.d/acai-backup
# Wynik każdego uruchomienia trafia do /var/log/acai-backup.log.
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

15 3 * * * root /var/www/acai-cup/scripts/backup.sh >> /var/log/acai-backup.log 2>&1
